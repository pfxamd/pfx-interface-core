{
  "$schema": "../schema/foundations.schema.json",
  "version": "0.1.0",
  "status": "active",
  "policy": {
    "consumeSemanticByDefault": true,
    "primitiveAccess": "foundation-authoring-only",
    "visualIdentity": "neutral-defaults-overridable-by-project",
    "contracts": "deferred-until-repeated-project-evidence"
  },
  "families": {
    "color": {
      "primitive": "tokens/primitive/color.json",
      "semantic": "tokens/semantic/color.json",
      "requiredSemantic": [
        "color.surface.canvas",
        "color.surface.subtle",
        "color.surface.elevated",
        "color.text.primary",
        "color.text.secondary",
        "color.text.muted",
        "color.text.inverse",
        "color.border.default",
        "color.border.strong",
        "color.action.primary",
        "color.action.primary-hover",
        "color.action.primary-text",
        "color.focus.ring",
        "color.state.disabled-surface",
        "color.state.disabled-text"
      ]
    },
    "spacing": {
      "primitive": "tokens/primitive/space.json",
      "semantic": "tokens/semantic/space.json",
      "requiredSemantic": [
        "space.control.inline-sm",
        "space.control.inline-md",
        "space.control.inline-lg",
        "space.control.block-sm",
        "space.control.block-md",
        "space.control.block-lg",
        "space.layout.gap-sm",
        "space.layout.gap-md",
        "space.layout.gap-lg",
        "space.layout.section-sm",
        "space.layout.section-md",
        "space.layout.section-lg"
      ]
    },
    "typography": {
      "primitive": "tokens/primitive/typography.json",
      "semantic": "tokens/semantic/typography.json",
      "requiredSemantic": [
        "font.body.family",
        "font.body.size",
        "font.body.line-height",
        "font.body.weight",
        "font.heading.family",
        "font.heading.weight",
        "font.heading.line-height",
        "font.heading.tracking",
        "font.code.family",
        "font.code.size",
        "font.code.line-height"
      ]
    },
    "motion": {
      "primitive": "tokens/primitive/motion.json",
      "semantic": "tokens/semantic/motion.json",
      "requiredSemantic": [
        "motion.duration.fast",
        "motion.duration.default",
        "motion.duration.slow",
        "motion.easing.standard",
        "motion.easing.enter",
        "motion.easing.exit"
      ]
    },
    "radius": {
      "primitive": "tokens/primitive/radius.json",
      "semantic": "tokens/semantic/radius.json",
      "requiredSemantic": [
        "radius.control.sm",
        "radius.control.md",
        "radius.control.lg",
        "radius.surface.default",
        "radius.surface.prominent",
        "radius.overlay.default",
        "radius.pill"
      ]
    },
    "border": {
      "primitive": "tokens/primitive/border.json",
      "semantic": "tokens/semantic/border.json",
      "requiredSemantic": [
        "border.width.default",
        "border.width.strong",
        "border.width.focus",
        "border.style.default",
        "border.focus.offset"
      ]
    },
    "shadow": {
      "primitive": "tokens/primitive/shadow.json",
      "semantic": "tokens/semantic/shadow.json",
      "requiredSemantic": [
        "shadow.surface.subtle",
        "shadow.surface.raised",
        "shadow.overlay.default"
      ]
    },
    "sizing": {
      "primitive": "tokens/primitive/size.json",
      "semantic": "tokens/semantic/size.json",
      "requiredSemantic": [
        "size.icon.sm",
        "size.icon.md",
        "size.icon.lg",
        "size.control.sm",
        "size.control.md",
        "size.control.lg",
        "size.target.minimum",
        "size.target.enhanced"
      ]
    },
    "zIndex": {
      "primitive": "tokens/primitive/z.json",
      "semantic": "tokens/semantic/z.json",
      "requiredSemantic": [
        "z.layer.base",
        "z.layer.raised",
        "z.layer.dropdown",
        "z.layer.overlay",
        "z.layer.modal",
        "z.layer.toast"
      ]
    },
    "layout": {
      "primitive": "tokens/primitive/layout.json",
      "semantic": "tokens/semantic/layout.json",
      "requiredSemantic": [
        "layout.container.readable",
        "layout.container.content",
        "layout.container.wide",
        "layout.grid.min-column",
        "layout.gutter.sm",
        "layout.gutter.md",
        "layout.gutter.lg"
      ]
    }
  }
}
