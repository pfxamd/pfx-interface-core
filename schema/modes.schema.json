{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfxamd.local/schema/modes.schema.json",
  "type": "object",
  "required": [
    "version",
    "status",
    "order",
    "axes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "default",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "default": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
