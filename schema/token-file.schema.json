{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfxamd.local/schema/token-file.schema.json",
  "title": "PFx Interface Core DTCG-aligned token source",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "color": {
      "$ref": "#/$defs/group"
    },
    "space": {
      "$ref": "#/$defs/group"
    },
    "size": {
      "$ref": "#/$defs/group"
    },
    "radius": {
      "$ref": "#/$defs/group"
    },
    "border": {
      "$ref": "#/$defs/group"
    },
    "font": {
      "$ref": "#/$defs/group"
    },
    "shadow": {
      "$ref": "#/$defs/group"
    },
    "motion": {
      "$ref": "#/$defs/group"
    },
    "z": {
      "$ref": "#/$defs/group"
    },
    "layout": {
      "$ref": "#/$defs/group"
    },
    "component": {
      "$ref": "#/$defs/group"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "type": {
      "enum": [
        "color",
        "dimension",
        "fontFamily",
        "fontWeight",
        "duration",
        "cubicBezier",
        "number",
        "strokeStyle",
        "border",
        "transition",
        "shadow",
        "gradient",
        "typography"
      ]
    },
    "token": {
      "type": "object",
      "properties": {
        "$type": {
          "$ref": "#/$defs/type"
        },
        "$value": {},
        "$ref": {
          "type": "string",
          "pattern": "^#(?:/.*)?$"
        },
        "$description": {
          "type": "string"
        },
        "$deprecated": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "$extensions": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "$value"
          ],
          "not": {
            "required": [
              "$ref"
            ]
          }
        },
        {
          "required": [
            "$ref"
          ],
          "not": {
            "required": [
              "$value"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "$type": {
          "$ref": "#/$defs/type"
        },
        "$description": {
          "type": "string"
        },
        "$deprecated": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "$extensions": {
          "type": "object"
        },
        "$extends": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^\\{[^{}.]+(?:\\.[^{}.]+)*\\}$"
            },
            {
              "pattern": "^#(?:/.*)?$"
            }
          ]
        },
        "$root": {
          "$ref": "#/$defs/token"
        }
      },
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    }
  }
}
