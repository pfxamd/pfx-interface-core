{
  "$schema": "../../schema/token-file.schema.json",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "3xl": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        }
      },
      "4xl": {
        "$type": "dimension",
        "$value": {
          "value": 36,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$value": 1.25
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.7
      }
    },
    "tracking": {
      "tight": {
        "$type": "dimension",
        "$value": {
          "value": -0.01,
          "unit": "rem"
        }
      },
      "normal": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "rem"
        }
      },
      "wide": {
        "$type": "dimension",
        "$value": {
          "value": 0.02,
          "unit": "rem"
        }
      }
    }
  }
}
